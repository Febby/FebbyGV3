---
// Compact credibility strip — displayed directly below the hero.
const items = [
  '10+ Years Working With the Web',
  '5+ Years in the Shopify Ecosystem',
  'Merchant-Focused Technical Support',
  'JavaScript · Liquid · AJAX Cart · App Integrations',
];
---

<section class="relative z-20 -mt-10 px-6">
  <div class="max-w-5xl mx-auto">
    <div
      class="reveal flex flex-wrap justify-center items-center gap-x-5 gap-y-2 px-6 py-4 rounded-2xl bg-surface border border-theme shadow-sm text-sm text-muted"
      style="--reveal-delay: 500ms"
    >
      {items.map((text) => (
        <span class="flex items-center gap-2">
          <span class="text-accent" aria-hidden="true">•</span>
          {text}
        </span>
      ))}
    </div>
  </div>
</section>
