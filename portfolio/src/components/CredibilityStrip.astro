---
// Compact credibility strip — displayed directly below the hero.
const items = [
  '10+ Years Working With the Web',
  '5+ Years in the Shopify Ecosystem',
  'Merchant-Focused Technical Support',
];
---

<section class="relative z-20 -mt-6 px-6">
  <div class="max-w-5xl mx-auto border-t border-theme">
    <div
      class="reveal flex flex-wrap justify-center items-center gap-x-4 gap-y-1 px-2 pt-4 text-[0.8125rem] text-muted"
      style="--reveal-delay: 400ms"
    >
      {items.map((text, i) => (
        <span class="flex items-center gap-4">
          {i > 0 && <span class="text-accent opacity-60" aria-hidden="true">•</span>}
          {text}
        </span>
      ))}
    </div>
    <p
      class="reveal text-center text-xs text-muted opacity-70 px-2 pt-1 pb-1"
      style="--reveal-delay: 460ms"
    >
      JavaScript · Liquid · AJAX Cart · App Integrations
    </p>
  </div>
</section>
