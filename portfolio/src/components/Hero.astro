---
// Hero section — two-column layout: headline/CTAs left, interactive 3D workspace scene right.
import HeroScene from './HeroScene.astro';

const badges = ['Shopify', 'JavaScript', 'React', 'WordPress', 'Technical Support'];
---
<section class="relative overflow-hidden">
  <div class="hero-glow" aria-hidden="true"></div>

  <div class="relative z-10 max-w-7xl mx-auto px-6 flex items-center min-h-[90vh] py-12 lg:py-14">
    <div class="grid w-full items-center gap-4 sm:gap-8 lg:grid-cols-[minmax(0,0.9fr)_minmax(0,1.1fr)] lg:gap-6">
      <div class="text-center lg:text-left">
        <h1 class="reveal text-4xl lg:text-5xl font-extrabold leading-tight tracking-tight text-theme mb-5" style="--reveal-delay: 0ms">
          Front-End Developer &<br class="hidden lg:block" />
          <span class="text-accent">Shopify Solutions Engineer</span>
        </h1>

        <p class="reveal text-lg md:text-xl text-muted leading-relaxed max-w-xl mx-auto lg:mx-0 mb-8" style="--reveal-delay: 100ms">
          I build clean, responsive websites and help eCommerce brands solve tricky
          front-end, cart, and app integration issues.
        </p>

        <div class="reveal flex flex-wrap justify-center lg:justify-start gap-3 mb-8" style="--reveal-delay: 200ms">
          <a href="#work" class="btn-primary">
            View Work
          </a>
          <a
            href="#blog"
            class="px-6 py-3 text-sm font-semibold rounded-full border transition-colors text-theme hover:text-accent"
            style="border-color: var(--color-border); background-color: var(--color-surface);"
          >
            Read Blog
          </a>
          <a
            href="#contact"
            class="px-6 py-3 text-sm font-semibold rounded-full transition-colors text-muted hover:text-accent"
            style="border: 1px solid var(--color-border);"
          >
            Work With Me
          </a>
        </div>

        <div class="reveal flex flex-wrap justify-center lg:justify-start gap-2" style="--reveal-delay: 300ms">
          {badges.map((badge) => (
            <span class="tag hero-tag">{badge}</span>
          ))}
        </div>
      </div>

      <div>
        <HeroScene />
      </div>
    </div>
  </div>
</section>

<style>
  .hero-glow {
    position: absolute;
    inset: 0;
    pointer-events: none;
    background:
      radial-gradient(38rem 24rem at 80% 34%, color-mix(in srgb, var(--color-accent) 9%, transparent), transparent 70%);
  }
</style>
