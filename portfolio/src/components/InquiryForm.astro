---
interface Props { id: string }
const { id } = Astro.props;
const siteKey = import.meta.env.PUBLIC_TURNSTILE_SITE_KEY || '';
---
<form class="inquiry-form text-left" id={id} action="/api/inquiry" method="post" data-site-key={siteKey} aria-describedby={`${id}-help ${id}-privacy`}>
  <p id={`${id}-help`} class="text-sm text-muted leading-relaxed mb-6">All fields are required unless marked optional. A store URL and reproduction steps help with investigation. Do not submit passwords, access tokens, or customer data.</p>
  <div class="grid sm:grid-cols-2 gap-5">
    <div>
      <label for={`${id}-name`}>Name</label>
      <input id={`${id}-name`} name="name" autocomplete="name" required maxlength="100" aria-describedby={`${id}-name-error`} />
      <p id={`${id}-name-error`} class="field-error" data-error="name"></p>
    </div>
    <div>
      <label for={`${id}-email`}>Email</label>
      <input id={`${id}-email`} name="email" type="email" autocomplete="email" required maxlength="254" aria-describedby={`${id}-email-error`} />
      <p id={`${id}-email-error`} class="field-error" data-error="email"></p>
    </div>
  </div>
  <div class="mt-5">
    <label for={`${id}-storeUrl`}>Store URL <span class="text-muted font-normal">(optional)</span></label>
    <input id={`${id}-storeUrl`} name="storeUrl" type="url" inputmode="url" autocomplete="url" maxlength="2048" aria-describedby={`${id}-store-hint ${id}-storeUrl-error`} />
    <p id={`${id}-store-hint`} class="text-sm text-muted mt-2">Include https://, for example https://your-store.com.</p>
    <p id={`${id}-storeUrl-error`} class="field-error" data-error="storeUrl"></p>
  </div>
  <div class="mt-5">
    <label for={`${id}-description`}>Issue or project description</label>
    <textarea id={`${id}-description`} name="description" rows="6" required minlength="10" maxlength="5000" aria-describedby={`${id}-description-hint ${id}-description-error`}></textarea>
    <p id={`${id}-description-hint`} class="text-sm text-muted mt-2">What happens, what did you expect, and how can it be reproduced? 10–5,000 characters.</p>
    <p id={`${id}-description-error`} class="field-error" data-error="description"></p>
  </div>
  <div class="inquiry-trap" aria-hidden="true" inert>
    <label for={`${id}-website`}>Leave this field empty</label>
    <input id={`${id}-website`} name="website" tabindex="-1" autocomplete="off" />
  </div>
  <div class="mt-5" data-verification></div>
  <p class="text-sm text-muted mt-2" data-verification-status role="status">Spam protection will load when this form is in view.</p>
  <p id={`${id}-privacy`} class="text-sm text-muted leading-relaxed mt-5">Your details are used to review and respond to your inquiry, sent to Febby Gunawan at me@febbygunawan.com. Vercel processes the form request, Resend processes email delivery, and Cloudflare Turnstile processes verification data for spam protection. Please share only information needed to discuss the work.</p>
  <button class="btn-primary mt-6" type="submit" disabled>Send inquiry</button>
  <p class="text-sm leading-relaxed mt-4" data-status role="status" aria-live="polite" tabindex="-1"></p>
  <noscript><p class="text-muted mt-4">This form requires JavaScript for spam protection. Please use the email link below instead.</p></noscript>
  <p class="text-sm text-muted mt-4">Prefer email? <a class="text-accent underline underline-offset-4 break-all" href="mailto:me@febbygunawan.com">me@febbygunawan.com</a></p>
</form>

<style>
  .inquiry-form { min-width: 0; }
  label { display: block; font-size: .875rem; font-weight: 600; margin-bottom: .5rem; }
  input, textarea { width: 100%; min-width: 0; border: 1px solid var(--color-muted); border-radius: .625rem; padding: .75rem; background: var(--color-bg); color: var(--color-text); font: inherit; }
  textarea { resize: vertical; }
  .field-error { font-size: .875rem; margin-top: .35rem; color: #b91c1c; }
  :global(.dark) .field-error { color: #fca5a5; }
  [aria-invalid="true"] { border-color: #b91c1c; }
  :global(.dark) [aria-invalid="true"] { border-color: #fca5a5; }
  button:disabled { opacity: .65; cursor: not-allowed; }
  .inquiry-trap { position: absolute; width: 1px; height: 1px; overflow: hidden; clip-path: inset(50%); }
</style>

<script>
  type Turnstile = {
    render: (element: HTMLElement, options: Record<string, unknown>) => string;
    reset: (id: string) => void;
  };
  const browser = window as Window & { turnstile?: Turnstile };
  let verificationLoader: Promise<void> | undefined;
  function loadVerification() {
    if (browser.turnstile) return Promise.resolve();
    if (!verificationLoader) {
      verificationLoader = new Promise<void>((resolve, reject) => {
        const script = document.createElement('script');
        script.src = 'https://challenges.cloudflare.com/turnstile/v0/api.js?render=explicit';
        script.async = true;
        const timeout = window.setTimeout(() => reject(new Error('Verification timed out')), 15000);
        script.onload = () => { clearTimeout(timeout); resolve(); };
        script.onerror = () => { clearTimeout(timeout); reject(new Error('Verification unavailable')); };
        document.head.append(script);
      });
    }
    return verificationLoader;
  }

  document.querySelectorAll<HTMLFormElement>('.inquiry-form').forEach((form) => {
    const button = form.querySelector<HTMLButtonElement>('button[type="submit"]')!;
    const status = form.querySelector<HTMLElement>('[data-status]')!;
    const verificationStatus = form.querySelector<HTMLElement>('[data-verification-status]')!;
    const fields = [...form.querySelectorAll<HTMLInputElement | HTMLTextAreaElement>('input:not([name="website"]), textarea')];
    let pending = false;
    let token = '';
    let widgetId: string | undefined;
    let started = false;
    form.noValidate = true;

    function showErrors(errors: Record<string, string>) {
      fields.forEach((field) => {
        const message = errors[field.name] || '';
        field.setAttribute('aria-invalid', message ? 'true' : 'false');
        form.querySelector<HTMLElement>(`[data-error="${field.name}"]`)!.textContent = message;
      });
    }

    async function startVerification() {
      if (started) return;
      started = true;
      const sitekey = form.dataset.siteKey;
      if (!sitekey) {
        verificationStatus.textContent = 'The inquiry form is not configured yet. Please email me instead.';
        return;
      }
      try {
        await loadVerification();
        widgetId = browser.turnstile!.render(form.querySelector<HTMLElement>('[data-verification]')!, {
          sitekey, action: 'inquiry', size: 'flexible', theme: 'auto',
          'response-field': false,
          callback: (value: string) => {
            token = value;
            button.disabled = pending;
            verificationStatus.textContent = 'Spam verification complete.';
          },
          'expired-callback': () => {
            token = '';
            button.disabled = true;
            verificationStatus.textContent = 'Verification expired. Please complete it again.';
            if (widgetId) browser.turnstile?.reset(widgetId);
          },
          'error-callback': () => {
            token = '';
            button.disabled = true;
            verificationStatus.textContent = 'Spam verification could not load. Reload the page or use the email link below.';
          },
        });
      } catch {
        verificationStatus.textContent = 'Spam verification could not load. Reload the page or use the email link below.';
      }
    }
    const observer = new IntersectionObserver((entries) => {
      if (entries.some((entry) => entry.isIntersecting)) {
        observer.disconnect();
        void startVerification();
      }
    }, { rootMargin: '200px' });
    observer.observe(form);
    form.addEventListener('focusin', () => { void startVerification(); }, { once: true });

    form.addEventListener('submit', async (event) => {
      event.preventDefault();
      if (pending) return;
      const errors: Record<string, string> = {};
      fields.forEach((field) => {
        field.value = field.value.trim();
        if (!field.checkValidity()) errors[field.name] = field.validationMessage;
        if (field.name === 'description' && field.value.length < 10) errors.description = 'Please use at least 10 characters to describe the issue.';
        if (field.name === 'storeUrl' && field.value) {
          try {
            const url = new URL(field.value);
            if (!['http:', 'https:'].includes(url.protocol) || url.username || url.password) errors.storeUrl = 'Use an http:// or https:// store URL without credentials.';
          } catch { errors.storeUrl = 'Enter a complete store URL, starting with https://.'; }
        }
      });
      showErrors(errors);
      if (Object.keys(errors).length) {
        status.textContent = 'Please correct the marked fields.';
        fields.find((field) => errors[field.name])?.focus();
        return;
      }
      if (!token) {
        status.textContent = 'Please complete spam verification, or use the email link below.';
        return;
      }
      pending = true;
      button.disabled = true;
      button.textContent = 'Sending…';
      form.setAttribute('aria-busy', 'true');
      fields.forEach((field) => { field.readOnly = true; });
      status.textContent = 'Sending your inquiry…';
      let accepted = false;
      try {
        const response = await fetch(form.action, {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ ...Object.fromEntries(new FormData(form)), token }),
          signal: AbortSignal.timeout(25000),
        });
        const result = await response.json();
        if (!response.ok || result.ok !== true) {
          if (result.errors) showErrors(result.errors);
          throw new Error(result.message || 'Your inquiry could not be accepted. Please try again or email me.');
        }
        accepted = true;
        form.reset();
        status.textContent = 'Thank you. Your inquiry was accepted for email delivery to Febby. This confirms submission, not inbox receipt.';
      } catch (error) {
        status.textContent = error instanceof Error && error.name === 'Error'
          ? error.message
          : 'Delivery could not be confirmed. Your entries are still here. Please email me before retrying to avoid sending a duplicate.';
      } finally {
        token = '';
        pending = false;
        form.removeAttribute('aria-busy');
        fields.forEach((field) => { field.readOnly = false; });
        button.textContent = 'Send inquiry';
        button.disabled = true;
        verificationStatus.textContent = 'Please complete spam verification for another submission.';
        if (widgetId) browser.turnstile?.reset(widgetId);
        if (accepted || !form.querySelector('[aria-invalid="true"]')) status.focus();
        else form.querySelector<HTMLElement>('[aria-invalid="true"]')?.focus();
      }
    });
  });
</script>
