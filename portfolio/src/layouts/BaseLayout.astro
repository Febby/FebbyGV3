---
// Base layout component that wraps every page.
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
  image?: string;
  type?: 'website' | 'article';
  noindex?: boolean;
}

const {
  title = 'Febby Gunawan',
  description = 'Front-End Developer & Shopify Solutions Engineer. I build clean, responsive websites and help eCommerce brands solve tricky front-end, cart, and app integration issues.',
  image = '/og-image.jpg',
  type = 'website',
  noindex = false,
} = Astro.props;

const siteUrl = Astro.site?.toString() || 'https://febbygunawan.com';
const canonicalURL = new URL(Astro.url.pathname, siteUrl);
const ogImageURL = new URL(image, siteUrl);
const siteName = 'Febby Gunawan';
const isHome = Astro.url.pathname === '/' || Astro.url.pathname === '/index.html';
const pageTitle = isHome ? title : `${title} | ${siteName}`;

const personSchema = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: 'Febby Gunawan',
  url: siteUrl,
  jobTitle: 'Front-End Developer & Shopify Solutions Engineer',
  sameAs: [
    'https://github.com/Febby',
    'https://www.linkedin.com/in/febby-gunawan-5a596026/',
  ],
  description,
  image: new URL('/og-image.jpg', siteUrl).toString(),
};
---
<!DOCTYPE html>
<html lang="en" class="dark">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalURL.toString()} />
    <meta name="robots" content={noindex ? 'noindex, nofollow' : 'index, follow'} />

    <!-- Favicon & theme -->
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="apple-touch-icon" sizes="180x180" href="/og-image.jpg" />
    <meta name="theme-color" content="#0f172a" />

    <!-- Open Graph -->
    <meta property="og:site_name" content={siteName} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalURL.toString()} />
    <meta property="og:type" content={type} />
    <meta property="og:image" content={ogImageURL.toString()} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:locale" content="en_US" />

    <!-- Twitter Card -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageURL.toString()} />

    <!-- Structured data -->
    <script type="application/ld+json" set:html={JSON.stringify(personSchema)} />

    <!-- Anti-flicker: apply saved theme before first paint -->
    <script is:inline>
      (function () {
        try {
          var saved = localStorage.getItem('theme');
          var prefersDark = window.matchMedia('(prefers-color-scheme: dark)').matches;
          var isDark = saved ? saved === 'dark' : prefersDark;
          document.documentElement.classList.toggle('dark', isDark);
        } catch (e) {}
      })();
    </script>
  </head>
  <body class="flex flex-col min-h-screen">
