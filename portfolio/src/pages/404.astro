---
// 404 page — served by Vercel for any unknown route.
import BaseLayout from '../layouts/BaseLayout.astro';
---
<BaseLayout
  title="Page not found"
  description="The page you're looking for doesn't exist or has moved."
  noindex
>
  <section class="py-32 px-4">
    <div class="max-w-xl mx-auto text-center">
      <span class="section-label">404</span>
      <h1 class="text-3xl md:text-4xl font-bold mb-4 text-theme">Page not found</h1>
      <p class="text-lg text-muted leading-relaxed mb-10">
        The page you're looking for doesn't exist or has moved.
      </p>
      <div class="flex flex-wrap justify-center gap-4">
        <a href="/" class="btn-primary">Back to home</a>
        <a
          href="/#blog"
          class="px-6 py-3 text-sm font-semibold rounded-full border transition-colors text-theme hover:text-accent"
          style="border-color: var(--color-border); background-color: var(--color-surface);"
        >
          Read the blog
        </a>
      </div>
    </div>
  </section>
</BaseLayout>
