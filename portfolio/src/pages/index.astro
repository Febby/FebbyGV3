---
// Home page — sections ordered: Hero, CredibilityStrip, About, Services, Shopify Problems, Case Studies, Blog, Resources, Skills, Contact.
import BaseLayout from '../layouts/BaseLayout.astro';
import Hero from '../components/Hero.astro';
import CredibilityStrip from '../components/CredibilityStrip.astro';
import AboutSection from '../components/AboutSection.astro';
import ServicesSection from '../components/ServicesSection.astro';
import ShopifyProblemsSection from '../components/ShopifyProblemsSection.astro';
import CaseStudiesSection from '../components/CaseStudiesSection.astro';
import BlogSection from '../components/BlogSection.astro';
import ResourcesSection from '../components/ResourcesSection.astro';
import SkillsSection from '../components/SkillsSection.astro';
import ContactSection from '../components/ContactSection.astro';
---
<BaseLayout
  title="Febby Gunawan – Front-End Developer & Shopify Solutions Engineer"
  description="I build clean, responsive websites and help eCommerce brands solve tricky front-end, cart, and app integration issues."
>
  <Hero />
  <CredibilityStrip />
  <AboutSection />
  <ServicesSection />
  <div id="work">
    <ShopifyProblemsSection />
    <CaseStudiesSection />
  </div>
  <BlogSection />
  <ResourcesSection />
  <SkillsSection />
  <ContactSection />
</BaseLayout>